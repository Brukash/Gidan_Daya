# Copy to .env and fill in from Supabase → Project Settings → API.
# Only public values belong here. These keys ship to the browser by design;
# they are protected by Row Level Security, not by secrecy.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Never put SUPABASE_SERVICE_ROLE_KEY in this file or anywhere in src/.
# Server-only secrets belong in Supabase Edge Function secrets.
